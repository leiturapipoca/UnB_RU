<div class="pagina">
  <div class="cabecalho-pagina">
    <div class="cabecalho-pagina__texto">
      <span class="etiqueta"><%= icone :prancheta, tamanho: 14 %> Operações</span>
      <h1>Painel de Controle</h1>
      <p>Bem-vindo(a), <%= funcionario_logado.nome %>.</p>
    </div>
  </div>

  <%= render "shared/flash" %>

  <% if sessao_operacao_atual %>
    <div class="cartao ponto-atual">
      <span class="estatistica__icone"><%= icone :catraca, tamanho: 22 %></span>
      <div>
        <p>
          Ponto de acesso: <%= sessao_operacao_atual.catraca.restaurante.nome %>
          — catraca <%= sessao_operacao_atual.catraca.numero %>
        </p>
        <span class="selo selo--verde">Sessão aberta</span>
      </div>
      <%= link_to "Trocar", ponto_acesso_path, class: "botao botao--secundario botao--pequeno", style: "margin-left:auto" %>
    </div>
  <% end %>

  <div class="grade grade--3">
    <%= link_to fastpass_path, class: "cartao acesso-rapido" do %>
      <span class="estatistica__icone"><%= icone :raio, tamanho: 22 %></span>
      <span><b>Validar entrada (FastPass)</b><small>Leia o código do passe do aluno sorteado.</small></span>
    <% end %>

    <%= link_to catraca_validacao_path, class: "cartao acesso-rapido" do %>
      <span class="estatistica__icone"><%= icone :cracha, tamanho: 22 %></span>
      <span><b>Validação de catraca (matrícula)</b><small>Libere a entrada pela matrícula do estudante.</small></span>
    <% end %>

    <%= link_to ponto_acesso_path, class: "cartao acesso-rapido" do %>
      <span class="estatistica__icone"><%= icone :catraca, tamanho: 22 %></span>
      <span><b>Trocar restaurante/catraca</b><small>Escolha em qual ponto você vai operar.</small></span>
    <% end %>

    <%= link_to relatorio_global_acessos_path, class: "cartao acesso-rapido" do %>
      <span class="estatistica__icone"><%= icone :arquivo, tamanho: 22 %></span>
      <span><b>Relatório global de acessos</b><small>Consulte as entradas por restaurante e catraca.</small></span>
    <% end %>

    <% if funcionario_logado.perfil_administrador? %>
      <%= link_to restaurantes_path, class: "cartao acesso-rapido" do %>
        <span class="estatistica__icone"><%= icone :predio, tamanho: 22 %></span>
        <span><b>Gerenciar restaurantes e catracas</b><small>Cadastre, edite e remova unidades e catracas.</small></span>
      <% end %>
    <% end %>
  </div>
</div>
