<div class="pagina">
  <div class="cabecalho-pagina">
    <div class="cabecalho-pagina__texto">
      <span class="etiqueta"><%= icone :bilhete, tamanho: 14 %> Sorteio FastPass</span>
      <h1><%= @sorteio.turno.tipo_refeicao_label %> — <%= @sorteio.data.strftime("%d/%m/%Y") %></h1>
      <p>
        Campus: <strong><%= @sorteio.turno.campus.nome %></strong> ·
        Status: <strong><%= @sorteio.status_label %></strong> ·
        Resultado previsto: <strong><%= @sorteio.data_hora_resultado.strftime("%d/%m/%Y %H:%M") %></strong>
      </p>
    </div>

    <% if @sorteio.status_inscricoes_abertas? %>
      <div class="cabecalho-pagina__acoes">
        <%= button_to "Realizar sorteio e notificar",
                      realizar_sorteio_path(@sorteio),
                      method: :post,
                      form: { data: { turbo: false } },
                      class: "botao" %>
        <%= button_to "Cancelar sorteio",
                      cancelar_sorteio_path(@sorteio),
                      method: :post,
                      form: { data: { turbo: false } } %>
      </div>
    <% end %>
  </div>

  <%= render "shared/flash" %>

  <div class="cartao">
    <h2>Resumo por Time-frame</h2>
    <% if @janelas.empty? %>
      <p>Este turno ainda não possui time-frames cadastrados. <%= link_to "Cadastrar agora", turno_path(@sorteio.turno) %></p>
    <% else %>
      <div class="tabela-envoltorio">
        <table>
          <thead>
            <tr>
              <th>Time-frame</th>
              <th>Cota de vagas</th>
              <th>Inscritos</th>
              <th>Contemplados</th>
            </tr>
          </thead>
          <tbody>
            <% @janelas.each do |janela| %>
              <% do_slot = @inscricoes.select { |i| i.janela_fastpass_id == janela.id } %>
              <tr>
                <td><strong><%= janela.horario_formatado %></strong></td>
                <td><%= janela.cota_vagas %></td>
                <td><%= do_slot.size %></td>
                <td><%= do_slot.count { |i| i.status_contemplado? || i.status_utilizada? } %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>

  <div class="cartao" style="margin-top:1.5rem">
    <h2>Inscrições (<%= @inscricoes.size %>)</h2>
    <% if @inscricoes.empty? %>
      <p>Nenhum estudante inscrito neste sorteio ainda.</p>
    <% else %>
      <div class="tabela-envoltorio">
        <table>
          <thead>
            <tr>
              <th>Estudante</th>
              <th>Matrícula</th>
              <th>Time-frame</th>
              <th>Status</th>
              <th>Código do Passe</th>
              <th>Notificação</th>
            </tr>
          </thead>
          <tbody>
            <% @inscricoes.each do |inscricao| %>
              <tr>
                <td><%= inscricao.estudante.nome %></td>
                <td><%= inscricao.estudante.matricula %></td>
                <td><%= inscricao.janela_fastpass.horario_formatado %></td>
                <td><span class="selo selo--azul"><%= InscricoesFastpassController::STATUS_LABELS[inscricao.status] || inscricao.status %></span></td>
                <td><strong><%= inscricao.codigo_passe || "-" %></strong></td>
                <td>
                  <% if inscricao.notificado_em.present? %>
                    <% if inscricao.estudante.notificacoes_ativas? %>
                      Enviada em <%= inscricao.notificado_em.strftime("%H:%M") %>
                    <% else %>
                      Bloqueada pelo aluno (<%= inscricao.notificado_em.strftime("%H:%M") %>)
                    <% end %>
                  <% else %>
                    Pendente
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>

  <p style="margin-top:1rem">
    <%= link_to "Voltar para Sorteios", sorteios_path %> ·
    <%= link_to "Configurar time-frames deste turno", turno_path(@sorteio.turno) %>
  </p>
</div>