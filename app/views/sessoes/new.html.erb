<div class="centro">
  <div class="cartao cartao--login">
    <span class="icone-quadro"><%= icone :cracha, tamanho: 22 %></span>
    <h1>Login do Funcionário</h1>
    <p class="subtitulo">Informe suas credenciais funcionais para iniciar a sessão segura e liberar o terminal de catraca.</p>

    <%= render "shared/flash" %>

    <%= form_with url: login_path, class: "formulario" do |f| %>
      <div class="campo">
        <div class="campo__linha">
          <%= f.label :siape, "SIAPE" %>
          <span class="campo__dica">Obrigatório</span>
        </div>
        <div class="entrada">
          <%= icone :usuario %>
          <%= f.text_field :siape, placeholder: "Ex: 1984201", autocomplete: "username", inputmode: "numeric", autofocus: true %>
        </div>
      </div>

      <div class="campo">
        <div class="campo__linha">
          <%= f.label :senha, "Senha" %>
          <span class="campo__dica">Obrigatório</span>
        </div>
        <div class="entrada">
          <%= icone :cadeado %>
          <%= f.password_field :senha, placeholder: "Digite sua senha", autocomplete: "current-password" %>
        </div>
      </div>

      <%= f.button type: "submit", class: "botao botao--cheio" do %>
        <%= icone :entrar %> Entrar
      <% end %>
    <% end %>
  </div>
</div>
