<div class="pagina pagina--estreita">
  <div class="cabecalho-pagina">
    <div class="cabecalho-pagina__texto">
      <span class="etiqueta"><%= icone :relogio, tamanho: 14 %> Módulo de administração</span>
      <h1>Configurar Turno</h1>
      <p>Defina o horário de cada refeição servida no restaurante.</p>
    </div>
  </div>

  <%= render "shared/flash" %>

  <div class="cartao">
    <%= form_with model: @turno, local: true, class: "formulario" do |f| %>
      <div class="campo">
        <%= f.label :tipo_refeicao, "Tipo de Refeição" %>
        <%= f.select :tipo_refeicao, [["Café da Manhã", "CAFE_DA_MANHA"], ["Almoço", "ALMOCO"], ["Jantar", "JANTAR"]] %>
      </div>

      <div class="grade grade--2">
        <div class="campo">
          <%= f.label :hora_inicio, "Hora início" %>
          <%= f.time_field :hora_inicio %>
        </div>

        <div class="campo">
          <%= f.label :hora_fim, "Hora fim" %>
          <%= f.time_field :hora_fim %>
        </div>
      </div>

      <%= f.submit "Salvar Turno", class: "botao" %>
    <% end %>
  </div>
</div>
