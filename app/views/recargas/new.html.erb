<div class="pagina pagina--estreita">
  <div class="cabecalho-pagina">
    <div class="cabecalho-pagina__texto">
      <span class="etiqueta"><%= icone :carteira, tamanho: 14 %> Carteira estudantil</span>
      <h1>Nova Recarga</h1>
      <p>Informe o valor e escolha a forma de pagamento para gerar a cobrança.</p>
    </div>
  </div>

  <%= render "shared/flash" %>

  <div class="cartao">
    <%= form_with model: @recarga, local: true, class: "formulario" do |f| %>
      <div class="campo">
        <%= f.label :valor, "Valor" %>
        <div class="entrada entrada--prefixo">
          <span class="prefixo">R$</span>
          <%= f.number_field :valor, step: 0.01, required: true, placeholder: "0,00" %>
        </div>
      </div>

      <div class="campo">
        <p style="font-size:.8rem; font-weight:700; margin-bottom:.4rem">Método de Pagamento:</p>

        <div class="opcao">
          <%= f.radio_button :metodo_pagamento, 'PIX', id: 'PIX', required: true %>
          <%= f.label :metodo_pagamento_pix, for: 'PIX', class: 'opcao__corpo' do %><%= icone :raio %> PIX<% end %>
        </div>

        <div class="opcao">
          <%= f.radio_button :metodo_pagamento, 'CARTAO_CREDITO', id: 'CARTAO_CREDITO', required: true %>
          <%= f.label :metodo_pagamento_cartao, for: 'CARTAO_CREDITO', class: 'opcao__corpo' do %><%= icone :carteira %> Cartão de Crédito<% end %>
        </div>
      </div>

      <%= f.submit "Gerar Cobrança", class: "botao botao--cheio" %>
    <% end %>
  </div>
</div>
