<div class="pagina pagina--estreita">
  <div class="cabecalho-pagina">
    <div class="cabecalho-pagina__texto">
      <span class="etiqueta"><%= icone :bilhete, tamanho: 14 %> FastPass</span>
      <h1>Nova Inscrição no FastPass</h1>
      <p>Escolha o turno e o time-frame em que você quer concorrer à entrada prioritária.</p>
    </div>
  </div>

  <%= render "shared/flash" %>

  <% if @ja_inscrito %>
    <div class="cartao vazio"><p>Inscrição já realizada</p></div>
  <% elsif @sorteios.empty? %>
    <div class="cartao vazio"><p>Nenhum sorteio aberto no momento.</p></div>
  <% else %>
    <% opcoes_turnos = @sorteios.map { |s| [InscricoesFastpassController::TURNO_LABELS[s.turno.tipo_refeicao] || s.turno.tipo_refeicao, s.id] } %>
    <% opcoes_janelas = @janelas.map { |j| ["#{j.hora_inicio.strftime('%H:%M')} - #{j.hora_fim.strftime('%H:%M')}", j.id] } %>

    <div class="cartao">
      <%= form_with model: @inscricao, url: inscricoes_fastpass_path, data: { turbo: false }, class: "formulario" do |f| %>
        <div class="campo">
          <%= f.label :sorteio_id, "Turno" %>
          <%= f.select :sorteio_id, options_for_select(opcoes_turnos, @sorteio_selecionado&.id), {}, onchange: "window.location.href='#{nova_inscricao_fastpass_path}?sorteio_id=' + this.value" %>
        </div>

        <% if opcoes_janelas.any? %>
          <div class="campo">
            <%= f.label :janela_fastpass_id, "Time-frame" %>
            <%= f.select :janela_fastpass_id, options_for_select(opcoes_janelas, @inscricao.janela_fastpass_id) %>
          </div>

          <%= f.submit "Confirmar Inscrição", class: "botao" %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <p style="margin-top:1rem">
    <%= link_to "Voltar para Minhas Inscrições", inscricoes_fastpass_path %>
  </p>
</div>
