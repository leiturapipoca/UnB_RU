<div class="pagina">
  <div class="cabecalho-pagina">
    <div class="cabecalho-pagina__texto">
      <span class="etiqueta"><%= icone :bilhete, tamanho: 14 %> FastPass</span>
      <h1>Minhas Inscrições FastPass</h1>
      <p>Acompanhe os sorteios em que você se inscreveu e o código do seu passe.</p>
    </div>
    <div class="cabecalho-pagina__acoes">
      <%= button_to (current_estudante.notificacoes_ativas? ? "Bloquear notificações" : "Ativar notificações"),
                    alternar_notificacoes_fastpass_path,
                    method: :patch,
                    form: { data: { turbo: false } } %>
      <%= link_to nova_inscricao_fastpass_path, class: "botao" do %><%= icone :mais %> Nova Inscrição FastPass<% end %>
    </div>
  </div>

  <%= render "shared/flash" %>

  <% if @inscricoes.empty? %>
    <div class="cartao vazio">
      <p>Nenhuma inscrição encontrada.</p>
    </div>
  <% else %>
    <div class="cartao">
      <div class="tabela-envoltorio">
        <table>
          <thead>
            <tr>
              <th>Turno</th>
              <th>Data</th>
              <th>Time-frame</th>
              <th>Status</th>
              <th>Código do Passe</th>
              <th>Notificação</th>
            </tr>
          </thead>
          <tbody>
            <% @inscricoes.each do |inscricao| %>
              <tr>
                <td><%= InscricoesFastpassController::TURNO_LABELS[inscricao.sorteio.turno.tipo_refeicao] || inscricao.sorteio.turno.tipo_refeicao %></td>
                <td><%= inscricao.sorteio.data.strftime("%d/%m/%Y") %></td>
                <td><%= "#{inscricao.janela_fastpass.hora_inicio.strftime('%H:%M')} - #{inscricao.janela_fastpass.hora_fim.strftime('%H:%M')}" %></td>
                <td><span class="selo selo--azul"><%= InscricoesFastpassController::STATUS_LABELS[inscricao.status] || inscricao.status %></span></td>
                <td><strong><%= inscricao.codigo_passe || "-" %></strong></td>
                <td>
                  <% if inscricao.notificado_em.present? %>
                    <% if !current_estudante.notificacoes_ativas? %>
                      Notificações bloqueadas
                    <% elsif inscricao.status_contemplado? || inscricao.status_utilizada? %>
                      Você ganhou o sorteio
                    <% elsif inscricao.status_nao_contemplado? %>
                      Você não ganhou o sorteio
                    <% else %>
                      -
                    <% end %>
                  <% else %>
                    -
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
</div>