<%# Esta tela mostra o resultado da validação em cartões grandes; o layout não deve repetir os avisos %>
<% content_for :flash_renderizado, "sim" %>
<div class="pagina">
  <div class="cabecalho-pagina">
    <div class="cabecalho-pagina__texto">
      <span class="etiqueta"><%= icone :catraca, tamanho: 14 %> Terminal da catraca</span>
      <h1>Validação de Catraca</h1>
      <p>Aproxime a identificação do leitor ou digite a matrícula do estudante.</p>
    </div>
  </div>

  <div class="terminal">
    <div class="cartao campo-grande">
      <div class="cartao__titulo">
        <span class="estatistica__icone"><%= icone :cracha, tamanho: 20 %></span>
        <h2>Leitura da identificação</h2>
      </div>

      <%= form_with url: catraca_validacao_path, local: true, class: "formulario" do |f| %>
        <div class="campo">
          <%= f.label :identificacao, "Passe a Identificação (Matrícula):" %>
          <div class="entrada">
            <%= icone :usuario %>
            <%= f.text_field :identificacao, autofocus: true, autocomplete: "off", inputmode: "numeric" %>
          </div>
        </div>

        <%= f.submit "Validar", class: "botao botao--cheio" %>
      <% end %>

      <% pendentes = Array(session[:historico_local]).size %>
      <p class="pendentes" style="margin-top:1rem">
        <%= icone :relogio, tamanho: 16 %>
        Registros aguardando sincronização:
        <span data-pendentes="<%= pendentes %>"><%= pendentes %></span>
      </p>
    </div>

    <div>
      <% if flash[:notice] %>
        <div class="resultado status-liberada" role="status">
          <%= icone :ok, tamanho: 32 %>
          <span><%= flash[:notice] %></span>
        </div>
      <% end %>

      <% if flash[:alert] %>
        <div class="resultado status-bloqueada" role="alert">
          <%= icone :erro, tamanho: 32 %>
          <span><%= flash[:alert] %></span>
        </div>
      <% end %>

      <% unless flash[:notice] || flash[:alert] %>
        <div class="cartao cartao--cinza vazio">
          <%= icone :catraca, tamanho: 32 %>
          <p>Aguardando leitura.<br>O resultado da validação aparece aqui.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
