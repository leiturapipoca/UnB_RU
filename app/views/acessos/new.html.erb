<h1>Validação de Catraca</h1>

<% if flash[:notice] %>
  <div class="status-liberada" style="color: green; font-weight: bold; margin-bottom: 20px;">
    <%= flash[:notice] %>
  </div>
<% end %>

<% if flash[:alert] %>
  <div class="status-bloqueada" style="color: red; font-weight: bold; margin-bottom: 20px;">
    <%= flash[:alert] %>
  </div>
<% end %>

<%= form_with url: catraca_validacao_path, local: true do |f| %>
  <div>
    <%= f.label :identificacao, "Passe a Identificação (Matrícula):" %>
    <%= f.text_field :identificacao, autofocus: true %>
  </div>
  
  <div style="margin-top: 10px;">
    <%= f.submit "Validar" %>
  </div>
<% end %>