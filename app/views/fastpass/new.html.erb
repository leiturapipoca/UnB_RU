<%# Esta tela mostra o resultado em cartões grandes; o layout não deve repetir os avisos %>
<% content_for :flash_renderizado, "sim" %>
<div class="pagina pagina--estreita">
  <div class="cabecalho-pagina">
    <div class="cabecalho-pagina__texto">
      <span class="etiqueta"><%= icone :raio, tamanho: 14 %> Validação rigorosa</span>
      <h1>Validar entrada (FastPass)</h1>
      <p>Digite o código do passe do aluno sorteado. A entrada só é liberada dentro do horário da janela.</p>
    </div>
  </div>

  <% if flash[:notice] %>
    <div class="resultado status-liberada" role="status"><%= icone :ok, tamanho: 28 %><span><%= flash[:notice] %></span></div>
  <% end %>
  <% if flash[:alert] %>
    <div class="resultado status-bloqueada" role="alert"><%= icone :erro, tamanho: 28 %><span><%= flash[:alert] %></span></div>
  <% end %>

  <div class="cartao campo-grande">
    <%= form_with url: fastpass_path, class: "formulario" do %>
      <div class="campo">
        <%= label_tag :codigo_passe, "Código do passe" %>
        <div class="entrada">
          <%= icone :bilhete %>
          <%= text_field_tag :codigo_passe, nil, autofocus: true, autocomplete: "off" %>
        </div>
      </div>
      <%= submit_tag "Validar entrada", class: "botao botao--cheio" %>
    <% end %>
  </div>

  <p style="margin-top:1rem"><%= link_to "Voltar ao painel", root_path %></p>
</div>
