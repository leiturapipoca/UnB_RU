<div class="pagina pagina--estreita">
  <div class="cabecalho-pagina">
    <div class="cabecalho-pagina__texto">
      <span class="etiqueta"><%= icone :arquivo, tamanho: 14 %> Relatórios</span>
      <h1>Relatório de Operação</h1>
      <p>Escolha o período e exporte as movimentações em PDF.</p>
    </div>
  </div>

  <%= render "shared/flash" %>

  <div class="cartao">
    <%= form_with url: exportar_relatorios_path(format: :pdf), method: :get, local: true, class: "formulario" do |f| %>
      <div class="grade grade--2">
        <div class="campo">
          <%= f.label :data_inicio, "Data Início" %>
          <%= f.date_field :data_inicio, required: true %>
        </div>

        <div class="campo">
          <%= f.label :data_fim, "Data Fim" %>
          <%= f.date_field :data_fim, required: true %>
        </div>
      </div>

      <%= f.submit "Exportar PDF", class: "botao" %>
    <% end %>
  </div>
</div>
