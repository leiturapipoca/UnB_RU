<div class="pagina pagina--estreita">
  <div class="cabecalho-pagina">
    <div class="cabecalho-pagina__texto">
      <span class="etiqueta"><%= icone :catraca, tamanho: 14 %> Configuração de ponto</span>
      <h1>Selecionar restaurante e catraca</h1>
      <p>Escolha onde você vai operar. As entradas registradas ficam ligadas a este ponto.</p>
    </div>
  </div>

  <%= render "shared/flash" %>

  <%= form_with url: ponto_acesso_path, class: "formulario" do %>
    <% @restaurantes.each_with_index do |restaurante, indice| %>
      <section class="cartao">
        <div class="cartao__titulo">
          <span class="passo"><%= indice + 1 %></span>
          <h2><%= restaurante.nome %></h2>
          <%= selo_status_restaurante(restaurante) %>
        </div>

        <% restaurante.catracas.sort_by(&:numero).each do |catraca| %>
          <label class="opcao">
            <%= radio_button_tag :catraca_id, catraca.id, false, id: "catraca_#{catraca.id}" %>
            <span class="opcao__corpo">
              <%= icone :catraca %>
              <span><%= restaurante.nome %> — Catraca <%= catraca.numero %></span>
              <span style="margin-left:auto"><%= selo_status_catraca(catraca) %></span>
            </span>
          </label>
        <% end %>
      </section>
    <% end %>

    <%= submit_tag "Selecionar", class: "botao botao--cheio" %>
  <% end %>
</div>
