<div class="pagina">
  <div class="cabecalho-pagina">
    <div class="cabecalho-pagina__texto">
      <span class="etiqueta"><%= icone :predio, tamanho: 14 %> Módulo de administração</span>
      <h1>Restaurantes e Catracas</h1>
      <p>Cadastre as unidades e as catracas físicas que os funcionários poderão selecionar.</p>
    </div>
    <div class="cabecalho-pagina__acoes">
      <%= link_to new_restaurante_path, class: "botao" do %><%= icone :mais %> Novo restaurante<% end %>
    </div>
  </div>

  <%= render "shared/flash" %>

  <div class="grade grade--3">
    <div class="cartao estatistica">
      <div>
        <div class="estatistica__rotulo">Total de restaurantes</div>
        <div class="estatistica__valor"><%= @restaurantes.size %></div>
        <div class="estatistica__sub"><%= @restaurantes.count(&:status_em_operacao?) %> em operação</div>
      </div>
      <span class="estatistica__icone"><%= icone :talheres, tamanho: 22 %></span>
    </div>

    <div class="cartao estatistica">
      <div>
        <div class="estatistica__rotulo">Catracas cadastradas</div>
        <div class="estatistica__valor"><%= @restaurantes.sum { |r| r.catracas.size } %></div>
        <div class="estatistica__sub">distribuídas nos restaurantes</div>
      </div>
      <span class="estatistica__icone"><%= icone :catraca, tamanho: 22 %></span>
    </div>

    <div class="cartao estatistica">
      <div>
        <div class="estatistica__rotulo">Catracas online</div>
        <div class="estatistica__valor"><%= @restaurantes.sum { |r| r.catracas.count(&:status_online?) } %></div>
        <div class="estatistica__sub">prontas para operar</div>
      </div>
      <span class="estatistica__icone"><%= icone :raio, tamanho: 22 %></span>
    </div>
  </div>

  <div class="cartao">
    <div class="cartao__titulo">
      <h2>Unidades cadastradas</h2>
    </div>

    <div class="tabela-envoltorio">
      <table>
        <thead>
          <tr><th>Nome</th><th>Campus</th><th>Status</th><th>Catracas</th><th></th></tr>
        </thead>
        <tbody>
          <% @restaurantes.each do |r| %>
            <tr id="restaurante_<%= r.id %>">
              <td><strong><%= r.nome %></strong></td>
              <td><%= r.campus.nome %></td>
              <td><%= selo_status_restaurante(r) %></td>
              <td><%= r.catracas.map { |c| "Catraca #{c.numero}" }.join(", ") %></td>
              <td>
                <div class="acoes">
                  <%= link_to edit_restaurante_path(r), class: "botao botao--secundario botao--pequeno" do %><%= icone :lapis, tamanho: 14 %> Editar<% end %>
                  <%= button_to restaurante_path(r), method: :delete, class: "botao botao--perigo botao--pequeno",
                        form: { data: { turbo_confirm: "Remover este restaurante e suas catracas?" } } do %><%= icone :lixeira, tamanho: 14 %> Remover<% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <p style="margin-top:1rem"><%= link_to "Voltar ao painel", root_path %></p>
</div>
