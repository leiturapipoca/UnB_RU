<% if @restaurante.errors.any? %>
  <div id="alert" role="alert"><%= icone :aviso %><span><%= @restaurante.errors.full_messages.to_sentence %></span></div>
<% end %>

<%= form_with model: @restaurante, class: "formulario" do |f| %>
  <section class="cartao">
    <div class="cartao__titulo"><span class="passo">1</span><h2>Dados do restaurante</h2></div>
    <div class="grade grade--2">
      <div class="campo">
        <%= f.label :campus_id, "Campus" %>
        <%= f.collection_select :campus_id, Campus.order(:nome), :id, :nome, prompt: "Selecione" %>
      </div>
      <div class="campo">
        <%= f.label :nome, "Nome" %>
        <%= f.text_field :nome %>
      </div>
      <div class="campo">
        <%= f.label :piso, "Piso" %>
        <%= f.number_field :piso %>
      </div>
      <div class="campo">
        <%= f.label :capacidade_lugares, "Capacidade de lugares" %>
        <%= f.number_field :capacidade_lugares %>
      </div>
      <div class="campo">
        <%= f.label :status, "Status do restaurante" %>
        <%= f.select :status, opcoes_status_restaurante %>
      </div>
    </div>
  </section>

  <section class="cartao">
    <div class="cartao__titulo"><span class="passo">2</span><h2>Catracas</h2></div>
    <%= f.fields_for :catracas do |c| %>
      <fieldset>
        <div class="grade grade--2">
          <div class="campo">
            <%= c.label :numero, "Número da catraca" %>
            <%= c.number_field :numero %>
          </div>
          <div class="campo">
            <%= c.label :descricao, "Descrição da catraca" %>
            <%= c.text_field :descricao %>
          </div>
          <div class="campo">
            <%= c.label :modo_operacional, "Modo operacional" %>
            <%= c.select :modo_operacional, opcoes_modo_catraca %>
          </div>
          <div class="campo">
            <%= c.label :status, "Status da catraca" %>
            <%= c.select :status, opcoes_status_catraca %>
          </div>
        </div>
        <% if c.object.persisted? %>
          <div>
            <%= c.check_box :_destroy %>
            <%= c.label :_destroy, "Remover esta catraca", style: "display:inline" %>
          </div>
        <% end %>
      </fieldset>
    <% end %>
  </section>

  <div class="botoes">
    <%= f.submit(@restaurante.new_record? ? "Cadastrar" : "Salvar", class: "botao") %>
    <%= link_to "Cancelar", restaurantes_path, class: "botao botao--secundario" %>
  </div>
<% end %>
